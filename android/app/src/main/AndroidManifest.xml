<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <!-- SECURITY (Play hardening 2026-06-21): strip permissions that transitive ML
         dependencies merge into the release manifest. This app is fully offline and
         uses NO telephony/push. google_mlkit_image_labeling pulls firebase-iid +
         vision-internal-vkp (INTERNET / ACCESS_NETWORK_STATE / c2dm push), and the
         tflite GPU lib (targetSdk<4) IMPLIES READ_PHONE_STATE / WRITE_EXTERNAL_STORAGE.
         ML Kit uses a BUNDLED LocalLabelerOptions model — it does not need the network,
         so removing INTERNET is safe (device-verified on the Nesne mission). -->
    <uses-permission
        android:name="android.permission.INTERNET"
        tools:node="remove"/>
    <uses-permission
        android:name="android.permission.ACCESS_NETWORK_STATE"
        tools:node="remove"/>
    <uses-permission
        android:name="android.permission.READ_PHONE_STATE"
        tools:node="remove"/>
    <uses-permission
        android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        tools:node="remove"/>
    <uses-permission
        android:name="com.google.android.c2dm.permission.RECEIVE"
        tools:node="remove"/>
    <uses-permission
        android:name="android.permission.SCHEDULE_EXACT_ALARM"/>
    <uses-permission
        android:name="android.permission.USE_EXACT_ALARM"/>
    <uses-permission
        android:name="android.permission.USE_FULL_SCREEN_INTENT"/>
    <uses-permission
        android:name="android.permission.POST_NOTIFICATIONS"/>
    <uses-permission
        android:name="android.permission.WAKE_LOCK"/>
    <uses-permission
        android:name="android.permission.RECEIVE_BOOT_COMPLETED"/>
    <uses-permission
        android:name="android.permission.VIBRATE"/>
    <uses-permission
        android:name="android.permission.CAMERA"/>
    <!-- MIS-04 (Phase 7): the microphone is used ONLY while a "Su Sesi" alarm task
         is active, to detect running-water sound on-device (offline YAMNet). Audio
         stays in an in-memory buffer; it is never recorded to disk or sent over the
         network, and capture ends when the mission ends. -->
    <uses-permission
        android:name="android.permission.RECORD_AUDIO"/>
    <!-- REMOVED 2026-07-26: FOREGROUND_SERVICE_MICROPHONE.
         The original rationale ("mic capture happens while a foreground service
         runs") did not hold: the mic is opened by the water mission from the
         VISIBLE RingScreen Activity (water_mission.dart AudioRecorder.startStream),
         never from a service. No service in this app declares the "microphone" FGS
         type — the only block that did pointed at a non-existent class and has been
         removed below. Declaring an FGS permission that nothing uses makes the Play
         permission declaration inaccurate (Phase 11 POL-04).
         Microphone therefore relies on the normal while-in-use model: it works while
         the Activity is in the foreground. KEEP_SCREEN_ON (added to the activity
         below) is what guarantees that during a mission. If background mic capture
         is ever needed, a REAL microphone-typed foreground service must be added
         together with this permission — not this permission alone. -->
    <!-- RECORD_AUDIO above stays: it is the actual runtime permission the water
         mission requests and uses (POL-04 = mic KEPT, code-verified). -->
    <!-- SEC-01: FLASHLIGHT removed — the torch is driven through mobile_scanner's
         camera2 path (CameraManager), which needs only CAMERA, not this legacy
         normal-level permission. -->
    <uses-permission
        android:name="android.permission.FOREGROUND_SERVICE"/>
    <application
        android:label="ScanAwake"
        android:name="${applicationName}"
        android:icon="@mipmap/ic_launcher"
        android:allowBackup="false"
        android:usesCleartextTraffic="false"
        android:showWhenLocked="true"
        android:turnScreenOn="true">
        <!-- SECURITY: drop the unused Firebase push receiver dragged in by ML Kit
             (firebase-iid). No push messaging is used. -->
        <receiver
            android:name="com.google.firebase.iid.FirebaseInstanceIdReceiver"
            tools:node="remove"/>
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:taskAffinity=""
            android:screenOrientation="portrait"
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize"
            android:showWhenLocked="true"
            android:turnScreenOn="true">
            <meta-data
                android:name="io.flutter.embedding.android.NormalTheme"
                android:resource="@style/NormalTheme"/>
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity>
        <meta-data
            android:name="flutterEmbedding"
            android:value="2"/>
        <service
            android:name="dev.fluttercommunity.plus.androidalarmmanager.AlarmService"
            android:permission="android.permission.BIND_JOB_SERVICE"
            android:exported="false"
            android:stopWithTask="false"/>
        <!-- REMOVED 2026-07-26 (Phase 10 device session finding): this block declared
             a service class that DOES NOT EXIST. alarm 5.1.5 ships
             services/NotificationService.kt, but the class inside it is
             `NotificationHandler(context)` — a plain helper, NOT a Service subclass
             (verified in the pub cache). The real foreground service is
             `com.gdelataillade.alarm.services.AlarmService : Service()`, which the
             alarm package declares in its OWN manifest with
             foregroundServiceType="mediaPlayback" and which hardcodes
             ServiceInfo.FOREGROUND_SERVICE_TYPE_MEDIA_PLAYBACK in startForeground()
             (AlarmService.kt:218-221).
             Consequence: the "microphone" FGS type here was never applied to any
             running service — it was inert config pointing at a phantom class.
             Keeping it would keep the Play permission declaration dishonest
             (see Phase 11 POL-04). -->
    </application>
    <queries>
        <intent>
            <action
                android:name="android.intent.action.PROCESS_TEXT"/>
            <data
                android:mimeType="text/plain"/>
        </intent>
    </queries>
</manifest>